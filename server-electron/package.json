{
  "name": "dusuco-erp-server",
  "version": "1.0.8",
  "description": "Servidor Electron e API REST para integracao Firebird 5 com Flutter Web",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "server": "node server/index.js",
    "diagnostico": "node diagnostico.js",
    "test": "node tests/run.js",
    "copy-web": "node scripts/copy-web.js && node scripts/get-cloudflared.js",
    "dist": "npm run copy-web && electron-builder --win nsis --publish never",
    "release": "node scripts/run-tests.js && npm run copy-web && electron-builder --win nsis --publish always",
    "test:release": "node scripts/run-tests.js"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^4.22.2",
    "multer": "^1.4.5-lts.1",
    "node-firebird": "^2.18.2",
    "qrcode": "^1.5.4",
    "sharp": "^0.33.5",
    "web-push": "^3.6.7",
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^30.5.1",
    "electron-builder": "^25.1.8"
  },
  "author": "wgravinajunior-design",
  "homepage": "https://github.com/wgravinajunior-design/Uprestaurante",
  "build": {
    "appId": "br.com.uprestaurante.server",
    "productName": "Uprestaurante",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "updater.js",
      "server/**",
      "ui/**",
      "tv_display/**",
      "kds_display/**",
      "orders_display/**",
      "public_display/**",
      "auth_display/**",
      "config/db.example.json",
      "web/**",
      "package.json",
      "service/service-admin.ps1",
      "server/filelog.js"
    ],
    "asarUnpack": [
      "**/node_modules/sharp/**",
      "**/node_modules/@img/**",
      "service/**"
    ],
    "win": {
      "target": "nsis",
      "publisherName": "Uprestaurante"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "wgravinajunior-design",
        "repo": "Uprestaurante"
      }
    ],
    "extraResources": [
      {
        "from": "bin/cloudflared.exe",
        "to": "bin/cloudflared.exe"
      }
    ]
  }
}